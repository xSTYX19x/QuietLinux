// QuietLinux main window. All logic is in Rust (src/main.rs); this file only lays
// out the controls and forwards the user's actions as callbacks.

import {
    Button, CheckBox, ComboBox, GroupBox, HorizontalBox, LineEdit, Palette, Slider,
    SpinBox, StandardListView, TabWidget, TextEdit, VerticalBox,
} from "std-widgets.slint";

export struct KeyCap {
    code: string,
    legend: string,
    // position and size in key units (1 u = 19 mm)
    x: float,
    y: float,
    w: float,
    h: float,
    round: bool,
    // the binding differs from the factory one (on any layer)
    changed: bool,
    // a short label of the normal layer's binding, if it is not the factory one
    bound: string,
    // per-key color, and a legend color that stays readable on it
    painted: bool,
    color: color,
    ink: color,
}

// A point on the color wheel (x, y from -1 to 1, value 0 to 1) and its color.
export struct WheelPick {
    hex: string,
    x: float,
    y: float,
    value: float,
}

component KeyboardView inherits Rectangle {
    in property <[KeyCap]> keys;
    in property <string> selected;
    // size of the drawing in key units
    in property <float> units-wide: 1;
    in property <float> units-high: 1;
    // show the per-key colors instead of the bindings
    in property <bool> paint;
    callback clicked(code: string);
    // right click
    callback erased(code: string);

    property <length> u: min(self.width / units-wide, self.height / units-high);
    // centered horizontally
    property <length> left: (self.width - root.units-wide * root.u) / 2;
    min-height: 160px;
    preferred-height: 260px;

    for cap in root.keys: Rectangle {
        x: root.left + cap.x * root.u + 1.5px;
        y: cap.y * root.u + 1.5px;
        width: cap.w * root.u - 3px;
        height: cap.h * root.u - 3px;
        border-radius: cap.round ? self.width / 2 : 4px;
        border-width: !root.paint && cap.changed ? 2px : 1px;
        border-color: !root.paint && cap.changed ? Palette.accent-background : Palette.border;
        background: root.paint && cap.painted
            ? cap.color
            : !root.paint && cap.code == root.selected
            ? Palette.selection-background
            : (touch.has-hover ? Palette.alternate-background : Palette.control-background);

        // the bound key's own legend, small in the corner
        // (not on the narrow macro keys: no room)
        if !root.paint && cap.bound != "" && cap.w >= 1: Text {
            x: 4px;
            y: 2px;
            text: cap.legend;
            font-size: max(7px, root.u * 0.17);
            color: Palette.alternate-foreground;
        }

        Text {
            width: parent.width - 4px;
            height: parent.height - 4px;
            text: !root.paint && cap.bound != "" ? cap.bound : cap.legend;
            font-weight: !root.paint && cap.bound != "" ? 600 : 400;
            // a binding on a narrow macro key gets a smaller font
            font-size: max(7px, root.u * (!root.paint && cap.bound != "" && cap.w < 1 ? 0.18 : 0.26));
            color: root.paint && cap.painted
                ? cap.ink
                : !root.paint && cap.code == root.selected ? Palette.selection-foreground : Palette.control-foreground;
            horizontal-alignment: center;
            vertical-alignment: center;
            wrap: word-wrap;
            overflow: elide;
        }

        touch := TouchArea {
            clicked => {
                root.clicked(cap.code);
            }
            pointer-event(event) => {
                if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                    root.erased(cap.code);
                }
            }
        }
    }
}

// A color as six hex digits, with a swatch and a color wheel to pick it.
component ColorField inherits HorizontalLayout {
    in property <string> label;
    in property <length> label-width: 90px;
    in property <string> placeholder: "e63000";
    in-out property <string> hex;
    in property <color> swatch;
    in property <image> wheel;
    // the color at a point of the wheel; the point of a color
    pure callback wheel-pick(x: float, y: float, value: float) -> WheelPick;
    pure callback wheel-find(hex: string) -> WheelPick;
    // the color was chosen (wheel or slider let go, or typed)
    callback committed();
    property <WheelPick> point;
    spacing: 8px;
    alignment: start;

    function pick(x: length, y: length, size: length) {
        root.point = root.wheel-pick(x / size * 2 - 1, y / size * 2 - 1, root.point.value);
        root.hex = root.point.hex;
    }

    Text {
        text: root.label;
        vertical-alignment: center;
        min-width: root.label-width;
    }

    Rectangle {
        width: 28px;
        height: 28px;
        border-radius: 4px;
        border-width: 1px;
        border-color: Palette.border;
        background: root.swatch;
        TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.point = root.wheel-find(root.hex);
                popup.show();
            }
        }
    }

    LineEdit {
        text <=> root.hex;
        placeholder-text: root.placeholder;
        width: 110px;
        edited => {
            root.committed();
        }
    }

    Button {
        text: "Pick …";
        clicked => {
            root.point = root.wheel-find(root.hex);
            popup.show();
        }
    }

    popup := PopupWindow {
        x: 98px;
        y: 34px;
        width: 244px;
        height: 300px;
        close-policy: PopupClosePolicy.close-on-click-outside;

        Rectangle {
            background: Palette.background;
            border-radius: 6px;
            border-width: 1px;
            border-color: Palette.border;
            drop-shadow-blur: 10px;
            drop-shadow-color: #00000050;
        }

        VerticalLayout {
            padding: 12px;
            spacing: 10px;

            Rectangle {
                width: 220px;
                height: 220px;

                Image {
                    source: root.wheel;
                    width: parent.width;
                    height: parent.height;
                }

                // where the color is on the wheel
                Rectangle {
                    x: (root.point.x + 1) / 2 * parent.width - 7px;
                    y: (root.point.y + 1) / 2 * parent.height - 7px;
                    width: 14px;
                    height: 14px;
                    border-radius: 7px;
                    border-width: 2px;
                    border-color: white;
                    drop-shadow-blur: 2px;
                    drop-shadow-color: black;
                }

                TouchArea {
                    mouse-cursor: crosshair;
                    pointer-event(event) => {
                        if event.kind == PointerEventKind.down {
                            root.pick(self.mouse-x, self.mouse-y, self.width);
                        }
                        if event.kind == PointerEventKind.up {
                            root.committed();
                        }
                    }
                    moved => {
                        if self.pressed {
                            root.pick(self.mouse-x, self.mouse-y, self.width);
                        }
                    }
                }
            }

            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: "Value";
                    vertical-alignment: center;
                }

                Slider {
                    minimum: 0;
                    maximum: 1;
                    value: root.point.value;
                    changed(v) => {
                        root.point = root.wheel-pick(root.point.x, root.point.y, v);
                        root.hex = root.point.hex;
                    }
                    released => {
                        root.committed();
                    }
                }
            }
        }
    }
}

component LightingPage inherits VerticalBox {
    in property <[string]> effects;
    in property <[string]> directions;
    in property <image> wheel;
    in-out property <int> effect-index;
    in-out property <int> color-mode;
    in-out property <string> color1;
    // index of the reactive effect in `effects`: its two colors have other names
    in property <int> reactive-index;
    in-out property <string> color2;
    in-out property <float> brightness;
    in-out property <float> speed;
    in-out property <int> direction-index;
    in property <bool> enabled;
    pure callback swatch(hex: string) -> color;
    pure callback wheel-pick(x: float, y: float, value: float) -> WheelPick;
    pure callback wheel-find(hex: string) -> WheelPick;
    // something changed: applied right away
    callback effect-changed();
    alignment: start;

    GroupBox {
        title: "Effect (stored in the keyboard; changes apply at once)";
        VerticalLayout {
            spacing: 10px;

            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: "Effect";
                    vertical-alignment: center;
                    min-width: 90px;
                }

                ComboBox {
                    model: root.effects;
                    current-index <=> root.effect-index;
                    selected => {
                        root.effect-changed();
                    }
                }
            }

            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: "Colors";
                    vertical-alignment: center;
                    min-width: 90px;
                }

                ComboBox {
                    model: ["One color", "Two colors", "Rainbow"];
                    current-index <=> root.color-mode;
                    selected => {
                        root.effect-changed();
                    }
                }
            }

            if root.color-mode <= 1: ColorField {
                label: root.color-mode == 0 ? "Color"
                    : root.effect-index == root.reactive-index ? "Key press" : "First color";
                hex <=> root.color1;
                swatch: root.swatch(root.color1);
                wheel: root.wheel;
                wheel-pick(x, y, v) => {
                    return root.wheel-pick(x, y, v);
                }
                wheel-find(hex) => {
                    return root.wheel-find(hex);
                }
                committed => {
                    root.effect-changed();
                }
            }
            if root.color-mode == 1: ColorField {
                label: root.effect-index == root.reactive-index ? "Background" : "Second color";
                hex <=> root.color2;
                swatch: root.swatch(root.color2);
                wheel: root.wheel;
                wheel-pick(x, y, v) => {
                    return root.wheel-pick(x, y, v);
                }
                wheel-find(hex) => {
                    return root.wheel-find(hex);
                }
                committed => {
                    root.effect-changed();
                }
            }

            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: "Brightness";
                    vertical-alignment: center;
                    min-width: 90px;
                }

                Slider {
                    minimum: 0;
                    maximum: 100;
                    value <=> root.brightness;
                    changed => {
                        root.effect-changed();
                    }
                }

                Text {
                    text: "\{round(root.brightness)} %";
                    vertical-alignment: center;
                    min-width: 48px;
                }
            }

            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: "Speed";
                    vertical-alignment: center;
                    min-width: 90px;
                }

                Slider {
                    minimum: 0;
                    maximum: 100;
                    value <=> root.speed;
                    changed => {
                        root.effect-changed();
                    }
                }

                Text {
                    text: "\{round(root.speed)} %";
                    vertical-alignment: center;
                    min-width: 48px;
                }
            }

            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: "Direction";
                    vertical-alignment: center;
                    min-width: 90px;
                }

                ComboBox {
                    model: root.directions;
                    current-index <=> root.direction-index;
                    selected => {
                        root.effect-changed();
                    }
                }
            }

        }
    }
}

component PerKeyPage inherits VerticalBox {
    in property <[KeyCap]> keys;
    in property <float> keyboard-width;
    in property <float> keyboard-height;
    in property <image> wheel;
    in-out property <string> brush;
    in-out property <string> top;
    in-out property <string> left-strip;
    in-out property <string> right-strip;
    in property <bool> enabled;
    pure callback swatch(hex: string) -> color;
    pure callback wheel-pick(x: float, y: float, value: float) -> WheelPick;
    pure callback wheel-find(hex: string) -> WheelPick;
    callback paint(code: string);
    callback erase(code: string);
    callback all-keys();
    callback clear();
    callback zones-changed();
    callback back-to-effect();

    HorizontalLayout {
        spacing: 12px;
        ColorField {
            label: "Brush";
            label-width: 50px;
            hex <=> root.brush;
            swatch: root.swatch(root.brush);
            wheel: root.wheel;
            wheel-pick(x, y, v) => {
                return root.wheel-pick(x, y, v);
            }
            wheel-find(hex) => {
                return root.wheel-find(hex);
            }
        }

        Button {
            text: "All keys";
            enabled: root.enabled;
            clicked => {
                root.all-keys();
            }
        }

        Button {
            text: "Clear";
            enabled: root.enabled;
            clicked => {
                root.clear();
            }
        }

        Rectangle {
            horizontal-stretch: 1;
        }

        Button {
            text: "Back to effect";
            enabled: root.enabled;
            clicked => {
                root.back-to-effect();
            }
        }
    }

    KeyboardView {
        keys: root.keys;
        units-wide: root.keyboard-width;
        units-high: root.keyboard-height;
        paint: true;
        vertical-stretch: 1;
        clicked(code) => {
            if root.enabled {
                root.paint(code);
            }
        }
        erased(code) => {
            if root.enabled {
                root.erase(code);
            }
        }
    }

    HorizontalLayout {
        spacing: 16px;
        alignment: start;
        ColorField {
            label: "Top bar";
            label-width: 60px;
            placeholder: "off";
            hex <=> root.top;
            swatch: root.swatch(root.top);
            wheel: root.wheel;
            wheel-pick(x, y, v) => {
                return root.wheel-pick(x, y, v);
            }
            wheel-find(hex) => {
                return root.wheel-find(hex);
            }
            committed => {
                root.zones-changed();
            }
        }

        ColorField {
            label: "Left strip";
            label-width: 70px;
            placeholder: "off";
            hex <=> root.left-strip;
            swatch: root.swatch(root.left-strip);
            wheel: root.wheel;
            wheel-pick(x, y, v) => {
                return root.wheel-pick(x, y, v);
            }
            wheel-find(hex) => {
                return root.wheel-find(hex);
            }
            committed => {
                root.zones-changed();
            }
        }

        ColorField {
            label: "Right strip";
            label-width: 75px;
            placeholder: "off";
            hex <=> root.right-strip;
            swatch: root.swatch(root.right-strip);
            wheel: root.wheel;
            wheel-pick(x, y, v) => {
                return root.wheel-pick(x, y, v);
            }
            wheel-find(hex) => {
                return root.wheel-find(hex);
            }
            committed => {
                root.zones-changed();
            }
        }
    }

    Text {
        text: "Click a key to paint it with the brush, right-click to switch it off. The colors show at once. They are not stored in the keyboard: unplugging it or applying an effect ends them.";
        color: Palette.alternate-foreground;
        wrap: word-wrap;
    }
}

component KeysPage inherits VerticalBox {
    in property <[KeyCap]> keys;
    in property <float> keyboard-width;
    in property <float> keyboard-height;
    in-out property <string> selected-key;
    in property <string> key-title;
    in property <string> binding-summary;
    in property <string> key-note;
    in property <bool> key-editable;
    in property <[string]> bind-targets;
    in property <[string]> bind-kinds;
    in property <[string]> bind-values;
    in-out property <int> bind-target;
    in-out property <int> bind-kind;
    in-out property <int> bind-value-index;
    in-out property <string> bind-text;
    in property <bool> enabled;
    callback key-clicked(code: string);
    callback editor-changed();
    callback apply-binding();

    KeyboardView {
        keys: root.keys;
        units-wide: root.keyboard-width;
        units-high: root.keyboard-height;
        selected: root.selected-key;
        vertical-stretch: 1;
        clicked(code) => {
            root.key-clicked(code);
        }
    }

    Text {
        text: "Keys with a highlighted border are bound to something other than their factory binding.";
        color: Palette.alternate-foreground;
        wrap: word-wrap;
    }

    GroupBox {
        title: root.key-title;
        vertical-stretch: 0;
        VerticalLayout {
            spacing: 8px;

            Text {
                text: root.binding-summary;
                wrap: word-wrap;
            }

            if root.key-note != "": Text {
                text: root.key-note;
                color: Palette.alternate-foreground;
                wrap: word-wrap;
            }

            if root.key-editable: HorizontalLayout {
                spacing: 8px;

                ComboBox {
                    model: root.bind-targets;
                    current-index <=> root.bind-target;
                    selected => {
                        root.editor-changed();
                    }
                }

                ComboBox {
                    model: root.bind-kinds;
                    current-index <=> root.bind-kind;
                    selected => {
                        root.editor-changed();
                    }
                }

                if root.bind-kind == 1: LineEdit {
                    text <=> root.bind-text;
                    placeholder-text: "ctrl+KeyC";
                    min-width: 160px;
                }
                if root.bind-values.length > 0 && root.bind-kind != 1: ComboBox {
                    model: root.bind-values;
                    current-index <=> root.bind-value-index;
                }

                Button {
                    text: "Apply";
                    primary: true;
                    enabled: root.enabled;
                    clicked => {
                        root.apply-binding();
                    }
                }
            }
        }
    }
}

// Record / Stop: mouse only, so that typing the macro can never press it.
component RecordButton inherits Rectangle {
    in property <bool> recording;
    in property <bool> enabled;
    callback clicked();
    height: 32px;
    width: label.preferred-width + 40px;
    border-radius: 4px;
    border-width: 1px;
    border-color: root.recording ? #c42b1c : Palette.border;
    background: root.recording ? #c42b1c : (touch.has-hover ? Palette.alternate-background : Palette.control-background);
    opacity: root.enabled ? 1 : 0.5;

    HorizontalLayout {
        padding-left: 12px;
        spacing: 8px;
        alignment: start;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 10px;
                height: 10px;
                border-radius: root.recording ? 2px : 5px;
                background: root.recording ? white : #c42b1c;
            }
        }

        label := Text {
            text: root.recording ? "Stop" : "Record";
            vertical-alignment: center;
            color: root.recording ? white : Palette.control-foreground;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

component MacrosPage inherits HorizontalBox {
    in property <[StandardListViewItem]> items;
    in-out property <int> current;
    in-out property <string> name;
    in-out property <int> repeat;
    in-out property <string> events;
    in property <bool> enabled;
    // recording: on now; pauses 0 none (50 ms), 1 fixed, 2 as recorded
    in property <bool> recording;
    in-out property <int> pause-mode;
    in-out property <int> pause-ms;
    callback selected(index: int);
    callback new-macro();
    callback save();
    callback delete();
    callback record();
    callback stop-recording();
    callback pause-changed();
    callback events-edited();

    VerticalLayout {
        spacing: 8px;
        width: 240px;

        StandardListView {
            model: root.items;
            current-item <=> root.current;
            current-item-changed(index) => {
                root.selected(index);
            }
        }

        Button {
            text: "New macro";
            enabled: root.enabled;
            clicked => {
                root.new-macro();
            }
        }
    }

    VerticalLayout {
        spacing: 8px;
        alignment: start;

        Text {
            text: root.current < 0 ? "New macro" : "Macro";
            font-weight: 600;
        }

        HorizontalLayout {
            spacing: 8px;
            Text {
                text: "Name";
                vertical-alignment: center;
                min-width: 70px;
            }

            LineEdit {
                text <=> root.name;
                placeholder-text: "up to 32 characters";
                // the recorded keys are typed into the focused field too
                enabled: !root.recording;
            }
        }

        HorizontalLayout {
            spacing: 8px;
            Text {
                text: "Repeat";
                vertical-alignment: center;
                min-width: 70px;
            }

            ComboBox {
                model: ["Once", "While held", "Repeat"];
                current-index <=> root.repeat;
            }
        }

        HorizontalLayout {
            spacing: 8px;
            Text {
                text: "Events";
                vertical-alignment: center;
                min-width: 70px;
            }

            RecordButton {
                recording: root.recording;
                enabled: root.recording || root.enabled;
                clicked => {
                    if root.recording {
                        root.stop-recording();
                    } else {
                        root.record();
                    }
                }
            }

            Text {
                text: "Pauses";
                vertical-alignment: center;
            }

            ComboBox {
                model: ["None (50 ms)", "Fixed", "As recorded"];
                current-index <=> root.pause-mode;
                selected => {
                    root.pause-changed();
                }
            }

            if root.pause-mode == 1: SpinBox {
                minimum: 0;
                maximum: 10000;
                step-size: 10;
                value <=> root.pause-ms;
                edited => {
                    root.pause-changed();
                }
            }
            if root.pause-mode == 1: Text {
                text: "ms";
                vertical-alignment: center;
            }
        }

        TextEdit {
            text <=> root.events;
            min-height: 120px;
            wrap: word-wrap;
            enabled: !root.recording;
            edited => {
                root.events-edited();
            }
        }

        Text {
            text: "KeyA taps a key, ctrl+KeyC a combination, +shift / -shift press / release a key, 250ms is a pause. Without a pause, 100 ms follow each event.";
            color: Palette.alternate-foreground;
            wrap: word-wrap;
        }

        HorizontalLayout {
            alignment: start;
            spacing: 8px;
            Button {
                text: root.current < 0 ? "Create" : "Save";
                primary: true;
                enabled: root.enabled;
                clicked => {
                    root.save();
                }
            }

            if root.current >= 0: Button {
                text: "Delete";
                enabled: root.enabled;
                clicked => {
                    root.delete();
                }
            }
        }
    }
}

component SettingsPage inherits VerticalBox {
    in-out property <bool> block-shift-tab;
    in-out property <bool> block-alt-f4;
    in-out property <bool> block-win;
    in-out property <bool> block-alt-tab;
    in-out property <bool> block-caps-lock;
    in-out property <string> file;
    in-out property <bool> overwrite;
    in property <string> checked-file;
    in property <string> file-details;
    in property <string> device-title;
    in property <bool> enabled;
    callback apply-game-mode();
    callback save-backup();
    callback check-file();
    callback apply-file();
    alignment: start;

    GroupBox {
        title: "Game mode: shortcuts it blocks (Fn+Pause switches game mode on and off)";
        HorizontalLayout {
            spacing: 16px;
            alignment: start;
            CheckBox {
                text: "Shift+Tab";
                checked <=> root.block-shift-tab;
            }

            CheckBox {
                text: "Alt+F4";
                checked <=> root.block-alt-f4;
            }

            CheckBox {
                text: "Win";
                checked <=> root.block-win;
            }

            CheckBox {
                text: "Alt+Tab";
                checked <=> root.block-alt-tab;
            }

            CheckBox {
                text: "Caps Lock";
                checked <=> root.block-caps-lock;
            }

            Button {
                text: "Apply";
                primary: true;
                enabled: root.enabled;
                clicked => {
                    root.apply-game-mode();
                }
            }
        }
    }

    GroupBox {
        title: "Backup: key bindings, game mode shortcuts and macros as a file";
        VerticalLayout {
            spacing: 8px;

            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: "File";
                    vertical-alignment: center;
                    min-width: 40px;
                }

                LineEdit {
                    text <=> root.file;
                    placeholder-text: "~/lightmount.toml";
                }
            }

            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                Button {
                    text: "Save backup";
                    enabled: root.enabled;
                    clicked => {
                        root.save-backup();
                    }
                }

                CheckBox {
                    text: "Overwrite";
                    checked <=> root.overwrite;
                }

                Rectangle {
                    width: 24px;
                }

                Button {
                    text: "Check file";
                    enabled: root.enabled;
                    clicked => {
                        root.check-file();
                    }
                }

                Button {
                    text: "Apply file";
                    primary: true;
                    // only what was checked can be applied
                    enabled: root.enabled && root.checked-file != "" && root.checked-file == root.file;
                    clicked => {
                        root.apply-file();
                    }
                }
            }

            Text {
                text: "A backup contains what your macros type: keep the file private. \"Check file\" lists what applying it would change; then \"Apply file\" writes it.";
                color: Palette.alternate-foreground;
                wrap: word-wrap;
            }

            if root.file-details != "": TextEdit {
                text: root.file-details;
                read-only: true;
                min-height: 120px;
            }
        }
    }

    GroupBox {
        title: "Device";
        Text {
            text: root.device-title != "" ? root.device-title : "Not connected";
            color: Palette.alternate-foreground;
        }
    }
}

// A row of choices, one of them selected (like tabs, but inside a page).
component Segmented inherits Rectangle {
    in property <[string]> items;
    in-out property <int> current;
    callback chosen(index: int);
    height: 32px;
    border-radius: 6px;
    border-width: 1px;
    border-color: Palette.border;
    background: Palette.alternate-background;

    HorizontalLayout {
        padding: 2px;
        spacing: 2px;
        for item[i] in root.items: Rectangle {
            border-radius: 4px;
            min-width: label.preferred-width + 28px;
            background: i == root.current
                ? Palette.accent-background
                : (touch.has-hover ? Palette.control-background : transparent);

            label := Text {
                text: item;
                color: i == root.current ? Palette.accent-foreground : Palette.foreground;
                font-weight: i == root.current ? 600 : 400;
            }

            touch := TouchArea {
                clicked => {
                    root.current = i;
                    root.chosen(i);
                }
            }
        }
    }
}

// A row of icons, one of them chosen by clicking it; a knob slides to it.
component IconSwitch inherits Rectangle {
    in property <[image]> icons;
    in-out property <int> value;
    in property <bool> enabled: true;
    callback chosen();
    property <length> cell: 30px;
    width: root.icons.length * self.cell + 4px;
    opacity: root.enabled ? 1 : 0.5;
    height: self.cell + 4px;
    border-radius: self.height / 2;
    border-width: 1px;
    border-color: Palette.border;
    background: Palette.alternate-background;

    Rectangle {
        x: 2px + root.value * root.cell;
        y: 2px;
        width: root.cell;
        height: root.cell;
        border-radius: root.cell / 2;
        background: Palette.accent-background;
        animate x {
            duration: 150ms;
            easing: ease-out;
        }
    }

    for icon[i] in root.icons: Rectangle {
        x: 2px + i * root.cell;
        y: 2px;
        width: root.cell;
        height: root.cell;

        Image {
            source: icon;
            width: 17px;
            height: 17px;
            colorize: i == root.value ? Palette.accent-foreground : Palette.foreground;
        }

        TouchArea {
            enabled: root.enabled;
            mouse-cursor: pointer;
            clicked => {
                root.value = i;
                root.chosen();
            }
        }
    }
}

// A small button with an icon.
component IconButton inherits Rectangle {
    in property <image> icon;
    in property <bool> active;
    callback clicked();
    width: 34px;
    height: 34px;
    border-radius: 6px;
    background: root.active
        ? Palette.accent-background
        : (touch.has-hover ? Palette.alternate-background : transparent);

    Image {
        source: root.icon;
        width: 20px;
        height: 20px;
        colorize: root.active ? Palette.accent-foreground : Palette.foreground;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

export component AppWindow inherits Window {
    title: "QuietLinux";
    icon: @image-url("icon.svg");
    preferred-width: 1100px;
    preferred-height: 720px;
    min-width: 760px;
    min-height: 520px;
    background: Palette.background;

    // model and firmware (settings), and a note for the title line
    in property <string> device-title;
    in property <string> device-note: "Looking for the keyboard …";
    in property <string> status;
    in property <bool> status-error;
    in property <bool> busy;
    in property <bool> connected;
    in-out property <int> page;
    // lighting tab: 0 effect, 1 per key; choosing one shows it on the keyboard
    in-out property <int> lighting-view;
    callback lighting-view-chosen();
    // the settings are shown instead of the tabs
    in-out property <bool> settings-open;
    // game mode: 0 unknown, 1 off, 2 on
    in property <int> game-mode;
    // 0 the system's, 1 light, 2 dark
    in-out property <int> theme;
    callback theme-chosen();
    callback refresh();

    changed theme => {
        Palette.color-scheme = root.theme == 1 ? ColorScheme.light
            : root.theme == 2 ? ColorScheme.dark : ColorScheme.unknown;
    }

    // lighting
    in property <[string]> effects;
    in property <[string]> directions;
    in property <image> wheel;
    in-out property <int> effect-index;
    in-out property <int> color-mode;
    in property <int> reactive-index;
    in-out property <string> color1: "e63000";
    in-out property <string> color2: "ffffff";
    in-out property <float> brightness: 100;
    in-out property <float> speed: 50;
    in-out property <int> direction-index;
    pure callback swatch(hex: string) -> color;
    pure callback wheel-pick(x: float, y: float, value: float) -> WheelPick;
    pure callback wheel-find(hex: string) -> WheelPick;
    callback effect-changed();
    // lighting: 0 off, 1 on; chosen in the title line
    in-out property <int> lighting-on: 1;
    callback lighting-chosen();

    // per key
    in-out property <string> brush: "e63000";
    in-out property <string> zone-top;
    in-out property <string> zone-left;
    in-out property <string> zone-right;
    callback paint-key(code: string);
    callback erase-key(code: string);
    callback paint-all();
    callback paint-clear();
    callback zones-changed();
    callback back-to-effect();

    // keys
    in property <[KeyCap]> keys;
    in property <float> keyboard-width;
    in property <float> keyboard-height;
    in-out property <string> selected-key;
    in property <string> key-title: "Click a key";
    in property <string> binding-summary;
    in property <string> key-note;
    in property <bool> key-editable;
    in property <[string]> bind-targets;
    in property <[string]> bind-kinds;
    in property <[string]> bind-values;
    in-out property <int> bind-target;
    in-out property <int> bind-kind;
    in-out property <int> bind-value-index;
    in-out property <string> bind-text;
    callback key-clicked(code: string);
    callback editor-changed();
    callback apply-binding();

    // macros
    in property <[StandardListViewItem]> macro-items;
    in-out property <int> macro-current: -1;
    in-out property <string> macro-name;
    in-out property <int> macro-repeat;
    in-out property <string> macro-events;
    callback macro-selected(index: int);
    callback macro-new();
    callback macro-save();
    callback macro-delete();
    in property <bool> recording;
    in-out property <int> pause-mode: 2;
    in-out property <int> pause-ms: 100;
    callback record();
    callback stop-recording();
    callback pause-changed();
    callback events-edited();

    // settings
    in-out property <bool> block-shift-tab;
    in-out property <bool> block-alt-f4;
    in-out property <bool> block-win;
    in-out property <bool> block-alt-tab;
    in-out property <bool> block-caps-lock;
    in-out property <string> file;
    in-out property <bool> overwrite;
    in property <string> checked-file;
    in property <string> file-details;
    callback apply-game-mode();
    callback save-backup();
    callback check-file();
    callback apply-file();

    property <bool> can-write: root.connected && !root.busy;

    VerticalLayout {
        HorizontalBox {
            VerticalLayout {
                alignment: center;
                IconSwitch {
                    icons: [@image-url("icons/bulb-off.svg"), @image-url("icons/bulb-on.svg")];
                    value <=> root.lighting-on;
                    enabled: root.can-write;
                    chosen => {
                        root.lighting-chosen();
                    }
                }
            }

            Text {
                text: root.device-note;
                color: Palette.alternate-foreground;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }

            if root.game-mode > 0: VerticalLayout {
                alignment: center;
                Rectangle {
                    height: 26px;
                    width: game-mode-text.preferred-width + 24px;
                    border-radius: 13px;
                    background: root.game-mode == 2 ? Palette.accent-background : Palette.alternate-background;
                    border-width: 1px;
                    border-color: root.game-mode == 2 ? Palette.accent-background : Palette.border;

                    game-mode-text := Text {
                        text: root.game-mode == 2 ? "Game mode: on" : "Game mode: off";
                        color: root.game-mode == 2 ? Palette.accent-foreground : Palette.alternate-foreground;
                        font-weight: root.game-mode == 2 ? 600 : 400;
                    }
                }
            }

            VerticalLayout {
                alignment: center;
                IconSwitch {
                    icons: [@image-url("icons/system.svg"), @image-url("icons/sun.svg"), @image-url("icons/moon.svg")];
                    value <=> root.theme;
                    chosen => {
                        root.theme-chosen();
                    }
                }
            }

            Button {
                text: root.connected ? "Reload" : "Connect";
                enabled: !root.busy;
                clicked => {
                    root.refresh();
                }
            }

            VerticalLayout {
                alignment: center;
                IconButton {
                    icon: @image-url("icons/gear.svg");
                    active: root.settings-open;
                    clicked => {
                        root.settings-open = !root.settings-open;
                    }
                }
            }
        }

        if !root.settings-open: TabWidget {
            current-index <=> root.page;

            Tab {
                title: "Lighting";
                VerticalLayout {
                    HorizontalBox {
                        alignment: start;
                        Segmented {
                            items: ["Effect", "Per key"];
                            current <=> root.lighting-view;
                            chosen => {
                                root.lighting-view-chosen();
                            }
                        }
                    }

                    if root.lighting-view == 0: LightingPage {
                            effects: root.effects;
                            directions: root.directions;
                            wheel: root.wheel;
                            reactive-index: root.reactive-index;
                            effect-index <=> root.effect-index;
                            color-mode <=> root.color-mode;
                            color1 <=> root.color1;
                            color2 <=> root.color2;
                            brightness <=> root.brightness;
                            speed <=> root.speed;
                            direction-index <=> root.direction-index;
                            enabled: root.can-write;
                            swatch(hex) => {
                                return root.swatch(hex);
                            }
                            wheel-pick(x, y, v) => {
                                return root.wheel-pick(x, y, v);
                            }
                            wheel-find(hex) => {
                                return root.wheel-find(hex);
                            }
                            effect-changed => {
                                root.effect-changed();
                            }
                        }

                    if root.lighting-view == 1: PerKeyPage {
                            keys: root.keys;
                            keyboard-width: root.keyboard-width;
                            keyboard-height: root.keyboard-height;
                            wheel: root.wheel;
                            brush <=> root.brush;
                            top <=> root.zone-top;
                            left-strip <=> root.zone-left;
                            right-strip <=> root.zone-right;
                            enabled: root.can-write;
                            swatch(hex) => {
                                return root.swatch(hex);
                            }
                            wheel-pick(x, y, v) => {
                                return root.wheel-pick(x, y, v);
                            }
                            wheel-find(hex) => {
                                return root.wheel-find(hex);
                            }
                            paint(code) => {
                                root.paint-key(code);
                            }
                            erase(code) => {
                                root.erase-key(code);
                            }
                            all-keys => {
                                root.paint-all();
                            }
                            clear => {
                                root.paint-clear();
                            }
                            zones-changed => {
                                root.zones-changed();
                            }
                            back-to-effect => {
                                root.back-to-effect();
                            }
                        }
                }
            }

            Tab {
                title: "Keys";
                KeysPage {
                    keys: root.keys;
                    keyboard-width: root.keyboard-width;
                    keyboard-height: root.keyboard-height;
                    selected-key <=> root.selected-key;
                    key-title: root.key-title;
                    binding-summary: root.binding-summary;
                    key-note: root.key-note;
                    key-editable: root.key-editable;
                    bind-targets: root.bind-targets;
                    bind-kinds: root.bind-kinds;
                    bind-values: root.bind-values;
                    bind-target <=> root.bind-target;
                    bind-kind <=> root.bind-kind;
                    bind-value-index <=> root.bind-value-index;
                    bind-text <=> root.bind-text;
                    enabled: root.can-write;
                    key-clicked(code) => {
                        root.key-clicked(code);
                    }
                    editor-changed => {
                        root.editor-changed();
                    }
                    apply-binding => {
                        root.apply-binding();
                    }
                }
            }

            Tab {
                title: "Macros";
                MacrosPage {
                    items: root.macro-items;
                    current <=> root.macro-current;
                    name <=> root.macro-name;
                    repeat <=> root.macro-repeat;
                    events <=> root.macro-events;
                    enabled: root.can-write;
                    selected(index) => {
                        root.macro-selected(index);
                    }
                    new-macro => {
                        root.macro-new();
                    }
                    save => {
                        root.macro-save();
                    }
                    delete => {
                        root.macro-delete();
                    }
                    recording: root.recording;
                    pause-mode <=> root.pause-mode;
                    pause-ms <=> root.pause-ms;
                    record => {
                        root.record();
                    }
                    stop-recording => {
                        root.stop-recording();
                    }
                    pause-changed => {
                        root.pause-changed();
                    }
                    events-edited => {
                        root.events-edited();
                    }
                }
            }
        }

        if root.settings-open: VerticalLayout {
            HorizontalBox {
                alignment: start;
                IconButton {
                    icon: @image-url("icons/arrow-left.svg");
                    clicked => {
                        root.settings-open = false;
                    }
                }

                Text {
                    text: "Settings";
                    font-size: 15px;
                    font-weight: 600;
                    vertical-alignment: center;
                }
            }

            SettingsPage {
                    block-shift-tab <=> root.block-shift-tab;
                    block-alt-f4 <=> root.block-alt-f4;
                    block-win <=> root.block-win;
                    block-alt-tab <=> root.block-alt-tab;
                    block-caps-lock <=> root.block-caps-lock;
                    file <=> root.file;
                    overwrite <=> root.overwrite;
                    checked-file: root.checked-file;
                    file-details: root.file-details;
                    device-title: root.device-title;
                    enabled: root.can-write;
                    apply-game-mode => {
                        root.apply-game-mode();
                    }
                    save-backup => {
                        root.save-backup();
                    }
                    check-file => {
                        root.check-file();
                    }
                    apply-file => {
                        root.apply-file();
                    }
                }
        }

        HorizontalBox {
            Text {
                text: root.busy && !root.recording ? "Working …" : root.status;
                color: root.status-error && !root.busy ? #d03030 : Palette.alternate-foreground;
                wrap: word-wrap;
                horizontal-stretch: 1;
            }
        }
    }
}
