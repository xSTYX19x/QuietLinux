<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>QuietLinux: third-party licenses</title>
<style>
body { font-family: sans-serif; max-width: 60rem; margin: 2rem auto; padding: 0 1rem; line-height: 1.4; }
pre { white-space: pre-wrap; background: #f4f4f4; padding: 1rem; font-size: 0.85rem; }
li { margin: 0.2rem 0; }
@media (prefers-color-scheme: dark) {
  body { background: #1c1c1c; color: #e8e8e8; }
  a { color: #8cc4ff; }
  pre { background: #2a2a2a; }
}
</style>
</head>
<body>
<h1>Third-party licenses</h1>
<p>QuietLinux is free software under the GNU General Public License, version 3
or later (see LICENSE). Its programs contain the Rust crates listed below, used
under these licenses.</p>

<h2>Overview</h2>
<ul>
{{#each overview}}
<li><a href="#{{id}}">{{name}}</a> ({{count}})</li>
{{/each}}
</ul>

<h2>License texts</h2>
{{#each licenses}}
<h3 id="{{id}}">{{name}}</h3>
<p>Used by:</p>
<ul>
{{#each used_by}}
<li><a href="{{#if crate.repository}}{{crate.repository}}{{else}}https://crates.io/crates/{{crate.name}}{{/if}}">{{crate.name}} {{crate.version}}</a></li>
{{/each}}
</ul>
<pre>{{text}}</pre>
{{/each}}
</body>
</html>
